[project]
title = Bezier Path Gallery
version = 0.5
dependencies#0 = https://github.com/ninecells-io/defold-helpers/archive/refs/tags/0.1.6.zip

[bootstrap]
main_collection = /example/example.collectionc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[display]
width = 1280
height = 800

[script]
shared_state = 1

[graphics]
texture_profiles = /builtins/graphics/default.texture_profiles

[library]
include_dirs = bezierpath


[render]
clear_color_red = 0.047
clear_color_green = 0.059
clear_color_blue = 0.071

[osx]
bundle_identifier = io.ninecells.bezierpath.gallery
