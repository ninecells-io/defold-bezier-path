[project]
title = bezierpath
version = 0.5
dependencies#0 = https://github.com/ninecells-io/defold-helpers/archive/refs/tags/0.1.1.zip

[bootstrap]
main_collection = /example/example.collectionc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[display]
width = 512
height = 512

[physics]
scale = 0.02

[script]
shared_state = 1

[graphics]
texture_profiles = /builtins/graphics/default.texture_profiles

[library]
include_dirs = bezierpath

