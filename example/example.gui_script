local bp = require "bezierpath.bezierpath"
local ui = require "example.gallery_ui"
local features = require "example.gallery_features"

local function cache_config(self)
    bp.configure_texture_cache({enabled=self.cache_enabled, folder="bezier-path-gallery", version="gallery-v1", max_size_bytes=8*1024*1024})
end
local function render_page(self, index)
    if self.page then gui.delete_node(self.page) end
    self.sprite_anchor=nil
    self.index=index
    self.cache_enabled=self.cache_enabled and index==7
    cache_config(self)
    bp.begin_texture_generation(self)
    self.page=ui.box(self.canvas,0,0,0,0)
    self.buttons={}
    for i,page in ipairs(features.pages) do
        local node=ui.button(self.page,137,616-(i-1)*60,222,page.title,i==index)
        self.buttons[#self.buttons+1]={node=node,index=i}
    end
    local page=features.pages[index]
    ui.text(self.page,294,680,page.title,30)
    ui.text(self.page,294,646,page.subtitle,16,ui.muted)
    local textures={}
    self.renders=0
    local function counted(draw)
        return function(...) self.renders=self.renders+1;return draw(...) end
    end
    for i,entry in ipairs(page.entries) do
        local x=440+((i-1)%3)*304
        local y=544-math.floor((i-1)/3)*174
        if entry.sprite then ui.box(self.page,x,y-51,288,50)
        else ui.box(self.page,x,y+5,288,162) end
        ui.text(self.page,x-130,y-49,entry.title,16)
        ui.caption(self.page,x-130,y-66,entry.description)
        local key="gallery:"..page.id..":"..i
        local draw=counted(entry.draw)
        local node,texture
        if entry.sprite then
            self.sprite_anchor=ui.box(self.page,x,y+15,0,0)
        elseif entry.box then
            node,texture=bp.add_gui_box(self.page,260,112,vmath.vector3(x,y+15,0),true,key,function(b) draw(b,1) end)
        else
            node=ui.box(self.page,x,y+15,260,112,vmath.vector4(1))
            if entry.region then
                -- Build in board coordinates, then crop around exactly that path.
                local handle=bp.create_path()
                bp.rounded_rect(handle,1020,2040,184,76,20)
                local bounds=bp.get_path_bounds(handle,4)
                bp.delete_path(handle)
                local region
                texture,region=bp.create_texture_region(key,bounds,function(b)
                    self.renders=self.renders+1
                    bp.with_path(b,function(h)
                        bp.rounded_rect(h,1020,2040,184,76,20)
                        bp.fill_path(b,{r=248,g=168,b=92,a=1})
                    end)
                end)
                gui.set_size(node,vmath.vector3(region.width,region.height,0))
            elseif entry.bytes then
                local bytes=bp.draw_texture(260,112,draw,1)
                texture=bp.set_node_texture(node,260,112,key,bytes)
            else
                texture=bp.create_texture(key,260,112,draw,nil,entry.factor or 1)
            end
            gui.set_texture(node,texture)
        end
        if node then gui.set_color(node,vmath.vector4(1));gui.set_size_mode(node,gui.SIZE_MODE_MANUAL) end
        if texture then textures[texture]=true end
        if entry.reuse then
            local reused=bp.create_texture(key,260,112,function() error("same-scene reuse unexpectedly rendered") end,nil,1)
            assert(reused==texture)
            -- Two thumbnails intentionally share one texture.
            gui.set_size(node,vmath.vector3(120,56,0))
            gui.set_position(node,vmath.vector3(x-66,y+15,0))
            local other=ui.box(self.page,x+66,y+15,120,56,vmath.vector4(1))
            gui.set_texture(other,reused)
        end
    end
    bp.end_texture_generation(self)
    self.texture_count=0
    for _ in pairs(textures) do self.texture_count=self.texture_count+1 end
    assert(self.texture_count<=9,"gallery exceeded its texture budget")
    if index==7 then
        self.toggle=ui.button(self.page,410,208,232,self.cache_enabled and "Disk cache: ON" or "Enable disk cache",self.cache_enabled)
        self.rebuild=ui.button(self.page,662,208,232,"Rebuild textures",false)
        self.clear=ui.button(self.page,914,208,232,"Clear + rebuild",false)
        ui.text(self.page,294,163,"Drawing callbacks: "..self.renders.."   /   Live page textures: "..self.texture_count,16,ui.accent)
        ui.text(self.page,294,134,"Enable, rebuild, then restart: a disk hit skips the drawing callback.",14,ui.muted)
    end
    ui.text(self.page,294,40,string.format("%02d / 07",index),14,ui.accent)
    ui.text(self.page,402,40,"Click a category or use keys 1-7",14,ui.muted)
    msg.post("/texture_demo#controller","show",{visible=index==6})
end
function init(self)
    msg.post(".","acquire_input_focus")
    self.root=ui.box(nil,640,400,0,0)
    gui.set_adjust_mode(self.root,gui.ADJUST_FIT)
    self.canvas=ui.box(self.root,-640,-400,0,0)
    gui.set_inherit_alpha(self.canvas,false)
    ui.text(self.canvas,28,749,"BEZIER / PATH",28)
    ui.text(self.canvas,28,714,"NATIVE TEXTURE LAB",12,ui.accent)
    ui.text(self.canvas,1000,748,"DEFOLD EXTENSION",14,ui.muted)
    ui.box(self.canvas,640,704,1224,1,vmath.vector4(0.18,0.22,0.24,1))
    ui.text(self.canvas,28,124,"Built from paths.",16,ui.ink)
    ui.text(self.canvas,28,100,"Rendered to pixels.",16,ui.muted)
    ui.text(self.canvas,28,40,"MIT / ninecells.io",12,ui.muted)
    self.cache_enabled=sys.get_config_int("gallery.cache",0)==1
    local index=math.max(1,math.min(7,sys.get_config_int("gallery.page",1)))
    render_page(self,index)
    self.smoke=sys.get_config_int("gallery.smoke",0)==1
    self.verify_cache=sys.get_config_int("gallery.verify_cache",0)==1
    self.elapsed=0
    self.step=0
    if self.smoke then
        -- Exercise the real Lua/native buffer boundary, not a stub.
        for _,premultiplied in ipairs({true,false}) do
            local b={buffer=buffer.create(1,{{name=hash("rgba"),type=buffer.VALUE_TYPE_UINT8,count=4}}),
                width=1,height=1,channels=4,premultiply_alpha=premultiplied,path_handle=0}
            bp.init_buffer(b,{r=255,g=0,b=0,a=0.5})
            local pixels=buffer.get_bytes(b.buffer,hash("rgba"))
            assert(string.byte(pixels,1)==(premultiplied and 127 or 255),"native buffer premultiplication flag was ignored")
        end
    end
end
local function handle_input(self,action_id,action)
    if not action.pressed then return end
    for i=1,7 do
        if action_id==hash("page"..i) then render_page(self,i);return true end
    end
    if action_id~=hash("touch") then return end
    for _,button in ipairs(self.buttons) do
        if gui.pick_node(button.node,action.x,action.y) then render_page(self,button.index);return true end
    end
    if self.index==7 then
        if gui.pick_node(self.toggle,action.x,action.y) then
            self.cache_enabled=not self.cache_enabled;render_page(self,7);return true
        elseif gui.pick_node(self.rebuild,action.x,action.y) then render_page(self,7);return true
        elseif gui.pick_node(self.clear,action.x,action.y) then bp.clear_texture_cache();render_page(self,7);return true
        end
    end
end
function on_input(self,action_id,action)
    return handle_input(self,action_id,action)
end
function update(self,dt)
    if self.verify_cache then
        self.verify_cache=false
        if self.renders~=0 then
            print("GALLERY_RESTART_CACHE_FAILED")
            msg.post("@system:","exit",{code=1})
        else
            print("GALLERY_RESTART_CACHE_PASSED")
            msg.post("@system:","exit",{code=0})
        end
    end
    if not self.smoke then return end
    self.elapsed=self.elapsed+dt
    if self.elapsed<0.5 then return end
    self.elapsed=0;self.step=self.step+1
    local ok,err=pcall(function()
        if self.step<=21 then
            local target=(self.step-1)%7+1
            if self.step%2==0 then
                handle_input(self,hash("touch"),{pressed=true,x=137,y=616-(target-1)*60})
            else handle_input(self,hash("page"..target),{pressed=true}) end
            assert(self.index==target,"category navigation failed")
        elseif self.step==22 then
            handle_input(self,hash("touch"),{pressed=true,x=410,y=208})
            assert(self.cache_enabled,"cache toggle button failed")
            handle_input(self,hash("touch"),{pressed=true,x=914,y=208})
            assert(self.renders>0,"cold cache unexpectedly skipped drawing")
        elseif self.step==23 then
            handle_input(self,hash("touch"),{pressed=true,x=662,y=208})
            assert(self.renders==0,"persistent cache missed")
        elseif self.step==24 then
            handle_input(self,hash("touch"),{pressed=true,x=914,y=208})
            assert(self.renders>0,"cache clear failed")
        else print("GALLERY_SMOKE_PASSED");msg.post("@system:","exit",{code=0}) end
    end)
    if not ok then
        self.smoke=false
        print("GALLERY_SMOKE_FAILED: "..tostring(err))
        msg.post("@system:","exit",{code=1})
    end
end
function final(self)
    if self.page then gui.delete_node(self.page) end
    bp.begin_texture_generation(self);bp.end_texture_generation(self)
end
