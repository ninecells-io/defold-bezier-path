- name: bezierpath
  type: table
  desc: Functions and constants for interacting with BezierPath extension

  members:

  - name: fill_color
    type: function
    desc: Fill the buffer with given color
    parameters:
    - name: buffer_info
      type: table
    - name: red
      type: number
    - name: green
      type: number
    - name: blue
      type: number
    - name: alpha
      type: number

  - name: get_path_bounds
    type: function
    desc: Return flattened path bounds expanded by optional padding
    parameters:
    - name: handle
      type: number
    - name: padding
      type: number
      optional: true
    returns:
    - type: table
      desc: Bounds with x, y, width, and height fields, or nil for an empty path
